<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ontherocks.cocktail.mapper.CategoryMapper">

    <select id="getAllCategories" resultType="com.ontherocks.cocktail.dto.CategoryDTO">
        SELECT category_id AS categoryId, category_name AS categoryName
        FROM categories
        WHERE category_name != '칵테일'  <!-- 칵테일 제외 -->
    </select>

</mapper>
